---
// A section's index, one page of it. Used by pages/[...section]/index.astro (page 1) and
// pages/[...section]/page/[page].astro.
import Base from '../layouts/Base.astro';
import NoteIndex from './NoteIndex.astro';
import { getNotes } from '../lib/notes';
import type { Section } from '../lib/site';
import { pageTitle } from '../lib/i18n';

interface Props {
  section: Section;
  page: number;
}

const { section, page } = Astro.props;
const notes = await getNotes(section);
---

<Base section={section} current={page === 1 ? 'index' : undefined} title={page > 1 ? pageTitle(page) : undefined}>
  <p class="intro">{section.description}</p>
  <NoteIndex section={section} notes={notes} page={page} />
</Base>
