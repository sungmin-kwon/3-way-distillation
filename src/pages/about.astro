---
import Base from '../layouts/Base.astro';
import { href, tagHref } from '../lib/notes';
import { SITE_FAMILY, SITE_TITLE, TAGS } from '../lib/site';

// Edit this list whenever the focus shifts, and bump the date. It is not shown while empty.
// Each item: text before the link, the linked note's id and title, text after.
const currentlyUpdated = '2026-11-11';
const currently: { before: string; note: string; title: string; after: string }[] = [];

const others = SITE_FAMILY.filter((s) => s.title !== SITE_TITLE);
---

<Base title="About" description="Whose notes these are, what the tags cover, and the sibling notebooks." current="about">
  <article class="entry">
    <h1>About</h1>
    <div class="prose">
      <p>
        I’m Sungmin. These are my working notes from graduate study and research in data science
        at Seoul National University: the methods, derivations and worked examples I want to be
        able to look up again later.
      </p>
      <p>The notes fall under these tags:</p>
      <ul class="eras">
        {TAGS.map((t) => (
          <li>{t.era && <><span class="label">{t.era}</span> </>}<a href={tagHref(t.name)}>{t.name}</a>: {t.blurb}</li>
        ))}
      </ul>
    </div>

    {currently.length > 0 && (
      <section class="about-block">
        <h2 class="label">Currently · updated <time datetime={currentlyUpdated}>{currentlyUpdated}</time></h2>
        <ul>
          {currently.map((c) => (
            <li>{c.before}<a href={href(`notes/${c.note}/`)}>{c.title}</a>{c.after}</li>
          ))}
        </ul>
      </section>
    )}

    {others.length > 0 && (
      <section class="about-block">
        <h2 class="label">Elsewhere</h2>
        <ul>
          {others.map((s) => (
            <li><a href={s.url}>{s.title}</a>: {s.blurb}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="about-block about-block-quiet">
      <h2 class="label">How to read this</h2>
      <p>
        Entries marked <span class="rough">rough</span> are unfinished thinking and
        may be wrong. Longer entries open with a short summary, so you can stop there.
      </p>
    </section>

    <p class="back"><a href={href()}>← index</a></p>
  </article>
</Base>
