---
import Base from '../../layouts/Base.astro';
import NoteIndex from '../../components/NoteIndex.astro';
import { allTags, getNotes, tagInfo, tagSlug } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return allTags(notes).map((tag) => ({ params: { tag: tagSlug(tag) }, props: { tag } }));
}

const { tag } = Astro.props;
const notes = await getNotes();
const info = tagInfo(tag);
const description = info
  ? `${info.description}`
  : tag === 'rough'
    ? 'Unfinished thinking; may be wrong.'
    : `Notes tagged ${tag}.`;
---

<Base title={tag} description={description}>
  <p class="intro">
    <span class="mono">{tag}</span>{info?.era && <> · {info.era}</>}. {description}
  </p>
  <NoteIndex notes={notes} tag={tag} />
</Base>
