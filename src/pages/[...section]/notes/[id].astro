---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {
  getNotes,
  isShort,
  isoDate,
  label,
  noteHref,
  readingMinutes,
  sectionHref,
  sectionPaths,
  tagHref,
} from '../../../lib/notes';
import { UI, minutes } from '../../../lib/i18n';
import { scriptFontStylesheets } from '../../../lib/site';

// A note's page, in its section. Older and newer are its neighbours within the section.
export async function getStaticPaths() {
  const paths = [];
  for (const { params, props } of sectionPaths()) {
    const notes = await getNotes(props.section);
    notes.forEach((note, i) =>
      paths.push({
        params: { ...params, id: note.id },
        props: { ...props, note, older: notes[i + 1] ?? null, newer: notes[i - 1] ?? null },
      }),
    );
  }
  return paths;
}

const { section, note, older, newer } = Astro.props;
const DISTILLATE_LABEL = section.distillateLabel;
const { Content, remarkPluginFrontmatter } = await render(note);
// A contents list for notes long enough to need one: four or more sections. The list of
// sections comes from src/lib/rehype-section-links.mjs.
const sections: { slug: string; text: string }[] = remarkPluginFrontmatter?.sections ?? [];
const showContents = sections.length >= 4;
const { title, date, updated, tags, summary, distillate, rough } = note.data;
---

<Base
  section={section}
  title={label(note)}
  description={summary ?? distillate}
  article={{ published: date, modified: updated, tags }}
  fontStylesheets={scriptFontStylesheets(note.body ?? '')}
>
  <article class="entry">
    <p class="back"><a href={sectionHref(section)}>{UI.back}</a></p>

    <p class="entry-meta">
      <time datetime={isoDate(date)}>{isoDate(date)}</time>
      {updated && <> · {UI.updated} <time datetime={isoDate(updated)}>{isoDate(updated)}</time></>}
      {tags.map((t) => <> · <a href={tagHref(t)}>{t}</a></>)}
      {rough && <> · <a class="rough" href={tagHref('rough', section)}>{UI.rough}</a></>}
      {!isShort(note) && <> · {minutes(readingMinutes(note))}</>}
    </p>

    {title && <h1>{title}</h1>}

    {distillate && (
      <aside class="distillate" aria-label={DISTILLATE_LABEL}>
        <p class="label">{DISTILLATE_LABEL}</p>
        <p>{distillate}</p>
      </aside>
    )}

    {showContents && (
      <nav class="contents" aria-label={UI.contents}>
        <details>
          <summary>{UI.contents}</summary>
          <ol>
            {sections.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <nav class="neighbours" aria-label={UI.neighbours}>
      {older ? <a href={noteHref(older)}>← {label(older, 48)}</a> : <span />}
      {newer ? <a href={noteHref(newer)}>{label(newer, 48)} →</a> : <a href={sectionHref(section)}>{UI.toIndex}</a>}
    </nav>
  </article>
</Base>
