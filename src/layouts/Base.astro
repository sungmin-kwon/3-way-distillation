---
import 'katex/dist/katex.min.css';
import '../styles/site.css';
import FamilyMenu from '../components/FamilyMenu.astro';
import { href, sectionHref } from '../lib/notes';
import {
  FAMILY_FONT_STYLESHEETS,
  FONT_CSS,
  FONT_STYLESHEET,
  HOME_PALETTE,
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_LANG,
  SITE_URL,
  paletteCss,
  type Section,
} from '../lib/site';
import { UI, themeSwitch } from '../lib/i18n';

interface Props {
  /** The notebook the page is in, for its title, colors and links. Undefined on the home page and the 404 page. */
  section?: Section;
  title?: string;
  description?: string;
  current?: 'index' | 'about';
  /** For a note's page: its dates and tags, for the link-preview tags. */
  article?: { published: Date; modified?: Date; tags: readonly string[] };
  /** Extra font stylesheets for rare scripts on the page (scriptFontStylesheets in lib/site). */
  fontStylesheets?: readonly string[];
}

const { section, title, current, article, fontStylesheets = [] } = Astro.props;
const siteTitle = section?.title ?? SITE_TITLE;
const description = Astro.props.description ?? section?.description ?? SITE_DESCRIPTION;
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
// Paths inside the page's own notebook, or from the site root on the home page.
const own = (path = '') => (section ? sectionHref(section, path) : href(path));
const PALETTE_CSS = paletteCss(section ? section.palette : HOME_PALETTE);
// Link previews (KakaoTalk, Slack, Messages and the like) read the Open Graph tags below.
// The canonical URL is the page's full address on the live site.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogLocale = SITE_LANG === 'ko' ? 'ko_KR' : 'en_US';
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply a saved theme before first paint; otherwise the system setting applies.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {PALETTE_CSS && <style is:inline set:html={PALETTE_CSS} />}
    {FONT_CSS && <style is:inline set:html={FONT_CSS} />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={article ? title : pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={ogLocale} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta property="og:image" content={new URL('og.png', section?.url ?? SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={own('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href={own('rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONT_STYLESHEET} />
    {FAMILY_FONT_STYLESHEETS.map((url) => <link rel="stylesheet" href={url} />)}
    {fontStylesheets.map((url) => <link rel="stylesheet" href={url} />)}
  </head>
  <body>
    <a class="skip" href="#main">{UI.skip}</a>
    <div class="page">
      <header class="masthead">
        <a class="site-name" href={own()} aria-current={current === 'index' ? 'page' : undefined}>
          {siteTitle}
        </a>
        <nav aria-label={UI.navLabel}>
          {section && <a href={own('about/')} aria-current={current === 'about' ? 'page' : undefined}>{UI.about}</a>}
          <a href={own('rss.xml')}>{UI.rss}</a>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            data-name-light={UI.themeName.light}
            data-name-dark={UI.themeName.dark}
            data-label-light={themeSwitch('light')}
            data-label-dark={themeSwitch('dark')}
            hidden
          >{UI.themeName.dark}</button>
          <FamilyMenu section={section} />
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="colophon">
        <FamilyMenu section={section} place="footer" />
      </footer>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        var current = function () {
          return root.dataset.theme || (media.matches ? 'dark' : 'light');
        };
        var sync = function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          btn.textContent = btn.getAttribute('data-name-' + next);
          btn.setAttribute('aria-label', btn.getAttribute('data-label-' + next));
        };
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          sync();
        });
        media.addEventListener('change', sync);
        btn.hidden = false;
        sync();
      })();
      (function () {
        // Close the header's family menu on Escape or a click outside it.
        var menu = document.querySelector('details.family');
        if (!menu) return;
        document.addEventListener('click', function (e) {
          if (menu.open && !menu.contains(e.target)) menu.open = false;
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary').focus();
          }
        });
      })();
    </script>
  </body>
</html>
